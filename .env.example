# Database
DATABASE_URL="postgresql://user:password@localhost:5432/imoveis_angola?schema=public"

# NextAuth / Auth.js
AUTH_SECRET="generate-a-strong-secret-here-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="Imóveis Angola"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="AOA"
NEXT_PUBLIC_CURRENCY_SYMBOL="Kz"
NEXT_PUBLIC_LOCALE="pt-AO"
NEXT_PUBLIC_TIMEZONE="Africa/Luanda"

# Storage (S3-compatible or Supabase)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="imoveis-angola"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
AWS_S3_BUCKET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="noreply@imoveisangola.ao"

# SMS / WhatsApp
SMS_API_KEY=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Maps
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# Commission
DEFAULT_COMMISSION_PERCENTAGE=10
