# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Imóveis Angola
NEXT_PUBLIC_CURRENCY=AOA
NEXT_PUBLIC_CURRENCY_SYMBOL=Kz
NEXT_PUBLIC_LOCALE=pt-AO
NEXT_PUBLIC_TIMEZONE=Africa/Luanda

# Database (Neon / PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth (NextAuth / Auth.js)
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Gateway de pagamentos ---
# Sandbox activo em desenvolvimento; em produção use PAYMENTS_SANDBOX=true só para testes
PAYMENTS_SANDBOX=true

# Multicaixa Express / EMIS
MULTICAIXA_MERCHANT_ID=
MULTICAIXA_API_KEY=
MULTICAIXA_API_URL=

# Unitel Money
UNITEL_MONEY_MERCHANT_CODE=
UNITEL_MONEY_API_KEY=
UNITEL_MONEY_API_URL=

# Transferência bancária (mostrado nas instruções)
BANK_NAME=Banco de Fomento Angola
BANK_ACCOUNT_NAME=Imóveis Angola Lda
BANK_IBAN=AO06 0040 0000 0000 0000 0000 1
